# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in your own values.

# SQL Server "sa" password: at least 8 characters with upper case, lower case, a digit and a symbol.
MSSQL_SA_PASSWORD=Change_Me_123!

# HMAC key for signing JWTs: at least 32 random characters.
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Password for the seeded demo accounts (hr@interface.local, sara.ali@interface.local).
SEED_DEMO_PASSWORD=Demo@12345

# Optional: Google sign-in (OAuth 2.0 Web client ID) and your Google email as an HR user.
GOOGLE_CLIENT_ID=
GOOGLE_HR_EMAIL=

# Optional: AutoMapper Community licence key.
AUTOMAPPER_LICENSE_KEY=
