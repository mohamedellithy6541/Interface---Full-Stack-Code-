{
  "ConnectionStrings": {
    "Default": "Server=.;Database=InterfacePayroll;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "interface-payroll-api",
    "Audience": "interface-payroll-client",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "AutoMapper": {
    "LicenseKey": ""
  },
  "Payroll": {
    "Currency": "EGP",
    "TaxBrackets": [
      { "UpTo": 10000, "Rate": 0.00 },
      { "UpTo": 30000, "Rate": 0.10 },
      { "UpTo": 50000, "Rate": 0.15 },
      { "UpTo": null, "Rate": 0.20 }
    ],
    "SocialInsuranceRate": 0.11,
    "SocialInsuranceMonthlyCap": 1500,
    "SocialInsuranceReducesTaxableIncome": true
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "Seed": {
    "Enabled": false,
    "DemoPassword": "",
    "GoogleHrEmails": []
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
