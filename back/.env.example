# Copy to .env (git-ignored) or set as environment variables / dotnet user-secrets.
# ASP.NET Core maps "__" to ":" so Jwt__SigningKey overrides Jwt:SigningKey in appsettings.json.

# SQL Server connection string (default in appsettings.json: local default instance, Windows auth)
ConnectionStrings__Default=Server=.;Database=InterfacePayroll;Trusted_Connection=True;TrustServerCertificate=True

# HMAC key for signing JWTs: at least 32 random characters. Required outside Development.
Jwt__SigningKey=replace-with-at-least-32-random-characters

# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services > Credentials). Empty disables Google sign-in.
Authentication__Google__ClientId=1234567890-abc.apps.googleusercontent.com

# Your Google account email, created as an HR user on startup so you can sign in with Google.
Seed__GoogleHrEmails__0=you@gmail.com

# Password for the seeded demo accounts (Development appsettings already sets a demo value).
Seed__DemoPassword=

# Optional AutoMapper license key (free Community license). Without it AutoMapper only logs a warning.
AutoMapper__LicenseKey=
